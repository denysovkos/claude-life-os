{
  "decimal_separator": ".",
  "thousands_separator": ",",
  "amount_pattern": "(?:[$£€]\\s?|(?:USD|GBP|EUR)\\s)(?P<amount>\\d{1,3}(?:,\\d{3})*(?:\\.\\d{2})?|\\d+(?:\\.\\d{2})?)",
  "date_patterns": [
    "(?P<y>\\d{4})-(?P<m>\\d{2})-(?P<d>\\d{2})",
    "(?P<mon>[A-Za-z]{3,9}\\.?)\\s(?P<d>\\d{1,2}),\\s(?P<y>\\d{4})",
    "(?P<d>\\d{1,2})\\s(?P<mon>[A-Za-z]{3,9}\\.?)\\s(?P<y>\\d{4})",
    "(?P<d>\\d{1,2})/(?P<m>\\d{1,2})/(?P<y>\\d{4})"
  ],
  "notes": "dd/mm/yyyy is assumed for slashed dates (UK and most of the world). A US sender writes mm/dd/yyyy: read the context, the pattern is only a tie-breaker.",
  "month_names": {
    "january": 1, "february": 2, "march": 3, "april": 4, "may": 5, "june": 6,
    "july": 7, "august": 8, "september": 9, "october": 10, "november": 11, "december": 12,
    "jan": 1, "feb": 2, "mar": 3, "apr": 4, "jun": 6, "jul": 7, "aug": 8,
    "sep": 9, "sept": 9, "oct": 10, "nov": 11, "dec": 12
  }
}
