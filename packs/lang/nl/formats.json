{
  "decimal_separator": ",",
  "thousands_separator": ".",
  "amount_pattern": "(?:€\\s?|EUR\\s)(?P<amount>\\d{1,3}(?:\\.\\d{3})*(?:,\\d{2}|,-)?|\\d+(?:,\\d{2}|,-)?)",
  "date_patterns": ["(?P<y>\\d{4})-(?P<m>\\d{2})-(?P<d>\\d{2})", "(?P<d>\\d{1,2})-(?P<m>\\d{1,2})-(?P<y>\\d{4})", "(?P<d>\\d{1,2})\\s(?P<mon>[a-z]{3,9}\\.?)\\s(?P<y>\\d{4})"],
  "notes": "Dates are day first with dashes (05-03-2026). The euro sign comes before the amount (€ 1.234,56); round amounts are sometimes written € 25,-, which the reference parser does not read.",
  "month_names": {
    "januari": 1,
    "februari": 2,
    "maart": 3,
    "april": 4,
    "mei": 5,
    "juni": 6,
    "juli": 7,
    "augustus": 8,
    "september": 9,
    "oktober": 10,
    "november": 11,
    "december": 12,
    "jan": 1,
    "feb": 2,
    "mrt": 3,
    "apr": 4,
    "jun": 6,
    "jul": 7,
    "aug": 8,
    "sep": 9,
    "sept": 9,
    "okt": 10,
    "nov": 11,
    "dec": 12
  }
}
