  "date_patterns": ["(?P<y>\\d{4})-(?P<m>\\d{2})-(?P<d>\\d{2})", "(?P<d>\\d{1,2})\\.(?P<m>\\d{1,2})\\.(?P<y>\\d{4}|\\d{2})\\b", "(?P<d>\\d{1,2})\\s(?P<mon>[а-яё]{3,9}\\.?)\\s(?P<y>\\d{4})"],
  "notes": "Month names appear in the genitive case in dates (5 марта 2026 г.). Thousands are separated by a space or a no-break space; the currency follows the amount.",
