{
  "decimal_separator": ",",
  "thousands_separator": " ",
  "amount_pattern": "(?P<amount>\\d{1,3}(?:[ \\u00a0]\\d{3})*(?:,\\d{2})|\\d+(?:,\\d{2}))\\s?(?:грн|₴|UAH|€|EUR)",
  "date_patterns": [
    "(?P<y>\\d{4})-(?P<m>\\d{2})-(?P<d>\\d{2})",
    "(?P<d>\\d{1,2})\\.(?P<m>\\d{1,2})\\.(?P<y>\\d{4}|\\d{2})\\b",
    "(?P<d>\\d{1,2})\\s(?P<mon>[а-яіїєґ']{3,10}\\.?)\\s(?P<y>\\d{4})"
  ],
  "notes": "Month names appear in the genitive case in dates (5 березня 2026). Thousands are separated by a space or a no-break space.",
  "month_names": {
    "січня": 1, "лютого": 2, "березня": 3, "квітня": 4, "травня": 5, "червня": 6,
    "липня": 7, "серпня": 8, "вересня": 9, "жовтня": 10, "листопада": 11, "грудня": 12,
    "січ": 1, "лют": 2, "бер": 3, "квіт": 4, "трав": 5, "черв": 6,
    "лип": 7, "серп": 8, "вер": 9, "жовт": 10, "лист": 11, "груд": 12
  }
}
